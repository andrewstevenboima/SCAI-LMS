          <name lang="en">A project coordinator notices that team members repeatedly move the same type of task into review and then manually assign it to a reviewer each time. Which Asana automation setup would best streamline this workflow while keeping the process consistent?</name>
          <description lang="en"></description>
          <interactionType>choice</interactionType>
          <correctResponsePatterns>
            
              <correctResponsePattern>choice_744bd378-61dd-4de2-b8ff-a928f3a8ee20</correctResponsePattern>
            
          </correctResponsePatterns>
          
            <choices>
              
                <component>
                  <id>choice_c8bed6f4-f023-4257-9905-61306b95f620</id>
                  <description lang="en">Ask team members to add a comment tagging the reviewer each time the task reaches review.</description>
                </component>
              
                <component>
                  <id>choice_cd99eb46-6eb7-4aab-96ba-8dda412dde47</id>
                  <description lang="en">Create a rule that moves the task to completion when the task moves to the review stage.</description>
                </component>
              
                <component>
                  <id>choice_744bd378-61dd-4de2-b8ff-a928f3a8ee20</id>
                  <description lang="en">Create a rule that assigns the task to the reviewer when the task moves to the review stage.</description>
                </component>
              
                <component>
                  <id>choice_aa498a58-43b6-4558-9460-4dfc5ee5abf2</id>
                  <description lang="en">Create a rule that assigns every new task to the reviewer as soon as it is created.</description>
                </component>
              
            </choices>
          
        </activity>
      
