            <choices>
              
                <component>
                  <id>choice_f10ce0d0-fa0e-4ec8-92ae-6dd123619088</id>
                  <description lang="en">Add the OKRs to the project description so team members can read them when they open the project.</description>
                </component>
              
                <component>
                  <id>choice_f8ef8a4c-3238-4805-90a8-79167d848356</id>
                  <description lang="en">Assign every project task to the team lead so ownership of the OKRs stays in one place.</description>
